<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Company>OPNX</Company>
    <Authors>OPNX</Authors>
    <Product>OPNX.UI</Product>
    <Copyright>Copyright (c) 2026 OPNX</Copyright>

    <Description>OPNX UI libraries for building stateful video applications on top of OPNX.Lib across multiple client platforms.</Description>
    <Version>0.1.0-preview.20260704.1</Version>
    <InformationalVersion>0.1.0-preview.20260704.1</InformationalVersion>

    <PackageProjectUrl>https://www.opnx.kr/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/OPNXLabs/opnx-ui</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageId>$(MSBuildProjectName)</PackageId>

    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>opnx;ui;wpf;video;vms;nvr;monitoring;dotnet</PackageTags>
  </PropertyGroup>

</Project>
