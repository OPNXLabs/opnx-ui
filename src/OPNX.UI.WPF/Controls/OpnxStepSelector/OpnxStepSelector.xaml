<UserControl x:Class="OPNX.UI.WPF.Controls.OpnxStepSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:OPNX.UI.WPF.Controls"
             mc:Ignorable="d"
             d:DesignHeight="32"
             d:DesignWidth="120"
             x:Name="Root">
    <Grid Background="Transparent"
          TextElement.Foreground="{Binding ElementName=Root, Path=Foreground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <local:OpnxButton x:Name="btnPrevious"
                          Grid.Column="0"
                          Width="{Binding ElementName=Root, Path=ButtonWidth}"
                          Height="{Binding ElementName=Root, Path=ButtonHeight}"
                          Margin="{Binding ElementName=Root, Path=PreviousButtonMargin}"
                          Padding="0"
                          Background="Transparent"
                          BorderBrush="Transparent"
                          BorderThickness="0"
                          CornerRadius="0"
                          MouseOverBackground="Transparent"
                          MouseOverBorderBrush="Transparent"
                          MouseOverForeground="{Binding ElementName=Root, Path=Foreground}"
                          MouseOverOpacity="0.7"
                          PressedBackground="Transparent"
                          PressedBorderBrush="Transparent"
                          PressedForeground="{Binding ElementName=Root, Path=Foreground}"
                          PressedOpacity="0.5"
                          DisabledOpacity="0.35"
                          Foreground="{Binding ElementName=Root, Path=Foreground}"
                          Content="{Binding ElementName=Root, Path=PreviousButtonContent}"
                          ContentTemplate="{Binding ElementName=Root, Path=PreviousButtonContentTemplate}"
                          ToolTip="{Binding ElementName=Root, Path=PreviousButtonToolTip}"
                          Style="{Binding ElementName=Root, Path=PreviousButtonStyle}"
                          Click="BtnPrevious_Click" />

        <ContentControl Grid.Column="1"
                        Margin="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{Binding ElementName=Root, Path=SelectedItem}"
                        ContentTemplate="{Binding ElementName=Root, Path=ItemTemplate}" />

        <local:OpnxButton x:Name="btnNext"
                          Grid.Column="2"
                          Width="{Binding ElementName=Root, Path=ButtonWidth}"
                          Height="{Binding ElementName=Root, Path=ButtonHeight}"
                          Margin="{Binding ElementName=Root, Path=NextButtonMargin}"
                          Padding="0"
                          Background="Transparent"
                          BorderBrush="Transparent"
                          BorderThickness="0"
                          CornerRadius="0"
                          MouseOverBackground="Transparent"
                          MouseOverBorderBrush="Transparent"
                          MouseOverForeground="{Binding ElementName=Root, Path=Foreground}"
                          MouseOverOpacity="0.7"
                          PressedBackground="Transparent"
                          PressedBorderBrush="Transparent"
                          PressedForeground="{Binding ElementName=Root, Path=Foreground}"
                          PressedOpacity="0.5"
                          DisabledOpacity="0.35"
                          Foreground="{Binding ElementName=Root, Path=Foreground}"
                          Content="{Binding ElementName=Root, Path=NextButtonContent}"
                          ContentTemplate="{Binding ElementName=Root, Path=NextButtonContentTemplate}"
                          ToolTip="{Binding ElementName=Root, Path=NextButtonToolTip}"
                          Style="{Binding ElementName=Root, Path=NextButtonStyle}"
                          Click="BtnNext_Click" />
    </Grid>
</UserControl>
