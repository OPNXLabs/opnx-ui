<UserControl x:Class="OPNX.UI.WPF.Controls.DefaultControlIcon"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OPNX.UI.WPF.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Width="Auto" Height="Auto">
    <Grid Margin="-3,-0.1,0,0" Width="22" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Top" Grid.Column="1" Grid.Row="0" Height="18" Background="{x:Null}">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform ScaleX="0.6" ScaleY="0.6"/>
                <SkewTransform AngleX="0" AngleY="0"/>
                <RotateTransform Angle="0"/>
                <TranslateTransform X="0" Y="0"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <Rectangle Stroke="#FF000000" StrokeThickness="1.5" RadiusX="0" RadiusY="0" Margin="0,0,0,0" VerticalAlignment="Stretch">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.175,0.175" StartPoint="0.825,0.825">
                    <GradientStop Color="#FF828282" Offset="0"/>
                    <GradientStop Color="#FFCFCFCF" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

    </Grid>

</UserControl>





