<UserControl x:Class="OPNX.UI.WPF.Controls.OpnxTitlebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OPNX.UI.WPF.Controls"
             x:Name="titlebar">
    <UserControl.Resources>
        <Style x:Key="TitlebarImageButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="{Binding ButtonSize, ElementName=titlebar}" />
            <Setter Property="Height" Value="{Binding ButtonSize, ElementName=titlebar}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="{Binding ButtonMargin, ElementName=titlebar}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                Opacity="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="{Binding ButtonMouseOverOpacity, ElementName=titlebar}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="{Binding ButtonPressedOpacity, ElementName=titlebar}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="{Binding ButtonDisabledOpacity, ElementName=titlebar}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitlebarButtonImageStyle" TargetType="{x:Type Image}">
            <Setter Property="Width" Value="{Binding ButtonImageSize, ElementName=titlebar}" />
            <Setter Property="Height" Value="{Binding ButtonImageSize, ElementName=titlebar}" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{Binding Background, ElementName=titlebar}"
          MouseDown="Titlebar_MouseDown"
          MouseMove="Titlebar_MouseMove"
          MouseUp="Titlebar_MouseUp">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0"
               Width="{Binding LogoWidth, ElementName=titlebar}"
               Height="{Binding LogoHeight, ElementName=titlebar}"
               Margin="{Binding LogoMargin, ElementName=titlebar}"
               Source="{Binding LogoSource, ElementName=titlebar}"
               Stretch="Uniform"
               VerticalAlignment="Center">
            <Image.Style>
                <Style TargetType="{x:Type Image}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LogoSource, ElementName=titlebar}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>

        <ContentPresenter Grid.Column="1"
                          Margin="{Binding TitleContentMargin, ElementName=titlebar}"
                          Content="{Binding TitleContent, ElementName=titlebar}"
                          ContentTemplate="{Binding TitleContentTemplate, ElementName=titlebar}"
                          VerticalAlignment="Center"
                          WindowChrome.IsHitTestVisibleInChrome="True" />

        <ContentPresenter Grid.Column="2"
                          Margin="{Binding RightContentMargin, ElementName=titlebar}"
                          Content="{Binding RightContent, ElementName=titlebar}"
                          ContentTemplate="{Binding RightContentTemplate, ElementName=titlebar}"
                          VerticalAlignment="Center"
                          WindowChrome.IsHitTestVisibleInChrome="True" />

        <StackPanel Grid.Column="3"
                    Margin="{Binding ControlBoxMargin, ElementName=titlebar}"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <Button ToolTip="{Binding MinimizeToolTip, ElementName=titlebar}"
                    Click="MinimizeButton_Click">
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TitlebarImageButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowMinimizeButton, ElementName=titlebar}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid>
                    <Image Source="{Binding MinimizeImageSource, ElementName=titlebar}">
                        <Image.Style>
                            <Style TargetType="{x:Type Image}" BasedOn="{StaticResource TitlebarButtonImageStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MinimizeImageSource, ElementName=titlebar}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock Text="_"
                               Foreground="{Binding ButtonForeground, ElementName=titlebar}"
                               FontSize="{Binding FallbackGlyphSize, ElementName=titlebar}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MinimizeImageSource, ElementName=titlebar}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Button>

            <Button ToolTip="{Binding CurrentMaximizeToolTip, ElementName=titlebar}"
                    Click="MaximizeButton_Click">
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TitlebarImageButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowMaximizeButton, ElementName=titlebar}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid>
                    <Image Source="{Binding MaximizeImageSource, ElementName=titlebar}">
                        <Image.Style>
                            <Style TargetType="{x:Type Image}" BasedOn="{StaticResource TitlebarButtonImageStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWindowMaximized, ElementName=titlebar}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MaximizeImageSource, ElementName=titlebar}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <Image Source="{Binding RestoreImageSource, ElementName=titlebar}">
                        <Image.Style>
                            <Style TargetType="{x:Type Image}" BasedOn="{StaticResource TitlebarButtonImageStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWindowMaximized, ElementName=titlebar}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RestoreImageSource, ElementName=titlebar}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock Foreground="{Binding ButtonForeground, ElementName=titlebar}"
                               FontSize="{Binding FallbackGlyphSize, ElementName=titlebar}"
                               HorizontalAlignment="Center"
                               Text="□"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsWindowMaximized, ElementName=titlebar}" Value="False" />
                                            <Condition Binding="{Binding MaximizeImageSource, ElementName=titlebar}" Value="{x:Null}" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsWindowMaximized, ElementName=titlebar}" Value="True" />
                                            <Condition Binding="{Binding RestoreImageSource, ElementName=titlebar}" Value="{x:Null}" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Button>

            <Button ToolTip="{Binding CloseToolTip, ElementName=titlebar}"
                    Click="CloseButton_Click">
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TitlebarImageButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowCloseButton, ElementName=titlebar}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid>
                    <Image Source="{Binding CloseImageSource, ElementName=titlebar}" Stretch="Fill">
                        <Image.Style>
                            <Style TargetType="{x:Type Image}" BasedOn="{StaticResource TitlebarButtonImageStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CloseImageSource, ElementName=titlebar}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock Text="X"
                               Foreground="{Binding ButtonForeground, ElementName=titlebar}"
                               FontSize="{Binding FallbackGlyphSize, ElementName=titlebar}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CloseImageSource, ElementName=titlebar}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
