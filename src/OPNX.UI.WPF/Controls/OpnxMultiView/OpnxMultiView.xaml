        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:OpnxMultiView}">

                    <!--<Grid d:DesignWidth="508" d:DesignHeight="331">-->
                    <Grid Background="Transparent">
    <!--<TextBlock x:Name="xTextBlock" Text="OpnxMultiView Test" Foreground="Black"/>-->

                        <Canvas x:Name="xZoomControl" Panel.ZIndex="-1"></Canvas>
                        <local:MultiViewPanel x:Name="xMultiViewPanel" Background="{TemplateBinding Background}" Margin="0,-1,0,0" Panel.ZIndex="0" ZoomCanvas="{Binding ElementName=xZoomControl}"/>

                        <Rectangle x:Name="xSelectionRect" StrokeThickness="2" IsHitTestVisible="False"
								   Fill="{x:Null}" Stroke="#18B8C9"
								   Visibility="{Binding Path=SelectionVisibility, RelativeSource={RelativeSource TemplatedParent}}"
								   Margin="{Binding Path=SelectionMargin, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Rectangle x:Name="xHighlightRect" StrokeThickness="2" IsHitTestVisible="False"
								   Fill="{x:Null}" Stroke="Blue"
								   Visibility="{Binding Path=HighlightVisibility, RelativeSource={RelativeSource TemplatedParent}}"
								   Margin="{Binding Path=HighlightMargin, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <!--<Rectangle x:Name="xControlModeRect" StrokeThickness="3" IsHitTestVisible="False"
								   Fill="{x:Null}" Stroke="Green"
								   Visibility="{Binding Path=ControlModeVisibility, RelativeSource={RelativeSource TemplatedParent}}"
								   Margin="{Binding Path=ControlModeMargin, RelativeSource={RelativeSource TemplatedParent}}"/>-->

                        <!--<Button x:Name="xZoomEndButton" Width="30" Height="30" Content="X"
							VerticalAlignment="Bottom" HorizontalAlignment="Right"
							Visibility="{Binding Path=ZoomEndButtonVisibility, RelativeSource={RelativeSource TemplatedParent}}"    
							Margin="{Binding ZoomEndButtonMargin, RelativeSource={RelativeSource TemplatedParent}}" Style="{DynamicResource sButton_GridClose}"/>

                        <ToggleButton x:Name="xHoldButton" Width="30" Height="30"
							VerticalAlignment="Bottom" HorizontalAlignment="Right"
							Visibility="{Binding Path=ZoomEndButtonVisibility, RelativeSource={RelativeSource TemplatedParent}}"    
							Margin="0,0,40,5" Style="{DynamicResource sButton_Hold}"/>-->

                        <Rectangle x:Name="xRectangleLock" Fill="Green" Opacity="0.000000000001" Panel.ZIndex="1" Visibility="Hidden" Margin="0,0,0,0"/>
                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="HighlightBorderStyle" Value="SelectionEnabled">
                            <!--<Setter TargetName="xHighlightRect" Property="Fill" Value="#7FFFFF00"/>-->
                            <Setter TargetName="xHighlightRect" Property="Stroke" Value="#FFB301"/>
                            <Setter TargetName="xHighlightRect" Property="StrokeThickness" Value="1.5"/>
                        </Trigger>
                        <Trigger Property="HighlightBorderStyle" Value="SelectionDisabled">
                            <Setter TargetName="xHighlightRect" Property="Fill" Value="#7F0000FF"/>
                            <Setter TargetName="xHighlightRect" Property="Stroke" Value="Blue"/>
                            <Setter TargetName="xHighlightRect" Property="StrokeDashArray" Value="2,1"/>
                        </Trigger>
                        <!--<DataTrigger Binding="{Binding Path=IsLocked}" Value="True">
