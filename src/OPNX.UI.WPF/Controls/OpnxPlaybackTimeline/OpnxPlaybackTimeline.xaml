                                    <Rectangle x:Name="xRectangleTemp02" Fill="Green" Height="15" Canvas.Left="415.665" Canvas.Top="160" Width="1082"/>
                                    <Rectangle x:Name="xRectangleTemp03" Fill="Green" Height="15" Canvas.Left="546.5" Canvas.Top="40" Width="679.863"/>
                                    <Rectangle x:Name="xRectangleTemp08" Fill="Green" Height="15" Canvas.Left="164.264" Canvas.Top="10" Width="422"/>
                                    
                                    <TextBlock TextWrapping="Wrap" Foreground="White" Canvas.Left="5" Canvas.Top="9" Width="104.243"><Run Language="ko-kr" Text="Sony Camera Test "/></TextBlock>
                                    <TextBlock TextWrapping="Wrap" Foreground="White" Canvas.Left="5" Canvas.Top="39" Width="99.368"><Run Language="ko-kr" Text="9층 회의실"/></TextBlock>
                                    <TextBlock TextWrapping="Wrap" Foreground="White" Canvas.Left="5" Canvas.Top="69" Width="99.368"><Run Language="ko-kr" Text="10층 회의실"/></TextBlock>
                                    <TextBlock TextWrapping="Wrap" Foreground="White" Canvas.Left="5" Canvas.Top="159" Width="99.368"><Run Language="ko-kr" Text="camera10928 AC"/></TextBlock>
                                    -->

                                <Rectangle x:Name="xRectangleLine01" Fill="#FF666666" Height="235" Width="1" Canvas.Left="144.264" SnapsToDevicePixels="True"/>
                                <Rectangle x:Name="xRectangleLine02" Fill="#FF666666" Height="235" Width="1" Canvas.Left="410.665" SnapsToDevicePixels="True"/>
                                <Rectangle x:Name="xRectangleLine03" Fill="#FF666666" Height="235" Width="1" Canvas.Left="685.112" SnapsToDevicePixels="True"/>
                                <Rectangle x:Name="xRectangleLine04" Fill="#FF666666" Height="235" Width="1" Canvas.Left="962.5" SnapsToDevicePixels="True"/>
                                <Rectangle x:Name="xRectangleLine05" Fill="#FF666666" Height="235" Width="1" Canvas.Left="1221.363" SnapsToDevicePixels="True"/>
                                <Rectangle x:Name="xRectangleLine06" Fill="#FF666666" Height="235" Width="1" Canvas.Left="1479.484" SnapsToDevicePixels="True"/>




                                <Grid x:Name="xGridEventInfo" Visibility="Collapsed">
                                    <Border x:Name="xBorderEventInfo" BorderBrush="Yellow" BorderThickness="1">
                                        <TextBlock x:Name="xTextBlockEventInfo" Width="Auto" Height="Auto" Background="Black" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </Canvas>
                        </ScrollViewer>

                        <Grid x:Name="xRectangleLineCenter">
                            <Rectangle Fill="#FF73A8F2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="1" Canvas.Top="0"/>
                            <Rectangle Fill="#FF73A8F2" Width="7" Height="7" VerticalAlignment="Bottom" Canvas.Bottom="0"/>
                        </Grid>
                    </Canvas>
                    <!--<Rectangle x:Name="xRectangleLineCenter" Fill="White" HorizontalAlignment="Center" Margin="0" Grid.Row="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="1"/>-->
                    <Rectangle Fill="#FF444444" Height="1" Margin="0" VerticalAlignment="Bottom" StrokeThickness="0" SnapsToDevicePixels="True"/>
                    <!--<Rectangle Fill="#FF444444" Height="1" Margin="0" VerticalAlignment="Bottom" StrokeThickness="0" SnapsToDevicePixels="True" Grid.Row="1"/>-->
                    <Rectangle Fill="#FF444444" Width="1" Margin="0" HorizontalAlignment="Left" StrokeThickness="0" SnapsToDevicePixels="True" Grid.RowSpan="2"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
