<UserControl x:Class="OPNX.UI.WPF.Controls.OpnxPlaybackTimeline.OpnxPlaybackTimeline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OPNX.UI.WPF.Controls.OpnxPlaybackTimeline"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="ListBoxStyRecordData" TargetType="{x:Type ListBox}">
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel Background="Transparent"
                        Height="15"
                        Margin="5,4,0,5.5"                         
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal">
                                <!--<oe_ui:CheckBox Width="15" Height="15" CheckBoxWidth="15" CheckBoxHeight="15" CheckBoxIConWidth="10" CheckBoxIConHeight="10"
                            Margin="0,0,0,0"
                                                Background="#202228"
                            Foreground="#c8c7c3"
                            IsChecked="{Binding IsChecked}"
                             VerticalAlignment="Center" />-->
                                <ToggleButton
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Focusable="False"
                            VerticalAlignment="Center"
                            Margin="5,0,0,0"
                            Width="155">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <TextBlock x:Name="Tzz"
                                               Text="{TemplateBinding Content}"
                                               Background="Transparent"
                                               VerticalAlignment="Center"
                                               Foreground="#c8c7c3"
                                               Padding="0"
                                               HorizontalAlignment="Left"
                                               Focusable="False"
                                               Margin="0"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Tzz" Property="Foreground" Value="#D2931A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ToggleButton.Content>
                                        <Binding Path="Entity.DisplayText"/>
                                    </ToggleButton.Content>
                                </ToggleButton>
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>

                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBox}">
                            <Border
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0">
                                <ScrollViewer Background="Transparent" 
                                      Margin="0" Padding="0"
                                      Focusable="False"
                                      BorderBrush="Transparent"
                                      BorderThickness="0"
                                      CanContentScroll="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Hidden">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Border
                                    x:Name="Bd"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0"
                                    SnapsToDevicePixels="true">
                                            <ContentPresenter
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True" />
                                                </MultiTrigger.Conditions>
                                            </MultiTrigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="Selector.IsSelectionActive" Value="False" />
                                                    <Condition Property="IsSelected" Value="True" />
                                                </MultiTrigger.Conditions>
                                            </MultiTrigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="Selector.IsSelectionActive" Value="True" />
                                                    <Condition Property="IsSelected" Value="True" />
                                                </MultiTrigger.Conditions>
                                                <!--<Setter TargetName="Bd" Property="BorderBrush" Value="#D2931A" />
                                        <Setter TargetName="Bd" Property="BorderThickness" Value="0 0 0 1" />-->
                                            </MultiTrigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="Transparent" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Border Margin="0" BorderBrush="Transparent" BorderThickness="0" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid x:Name="xLeftPanel" Grid.Column="0" Margin="0,0,0,0" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#55596B">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Border Grid.Column="0" Grid.Row="0" Background="#14151A" Margin="0,0,1,1">
                            <TextBlock Grid.Row="0" Text="시간간격" FontFamily="NanumBarunGothic" Foreground="White" FontSize="13" HorizontalAlignment="Center" Margin="0" VerticalAlignment="Center"></TextBlock>
                        </Border>
                        <Border Grid.Column="0" Grid.Row="1" Background="#14151A" Margin="0,0,1,0">
                            <TextBlock Grid.Row="1" FontFamily="NanumBarunGothic" Foreground="White" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource  Mode=FindAncestor, AncestorType=local:OpnxPlaybackTimeline}, Path=CurrentTimeRange}" Value="{x:Static local:PlaybackTimelineRangeType.M5}">
                                                <Setter Property="Text" Value="5분"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource  Mode=FindAncestor, AncestorType=local:OpnxPlaybackTimeline}, Path=CurrentTimeRange}" Value="{x:Static local:PlaybackTimelineRangeType.M15}">
                                                <Setter Property="Text" Value="15분"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource  Mode=FindAncestor, AncestorType=local:OpnxPlaybackTimeline}, Path=CurrentTimeRange}" Value="{x:Static local:PlaybackTimelineRangeType.M30}">
                                                <Setter Property="Text" Value="30분"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource  Mode=FindAncestor, AncestorType=local:OpnxPlaybackTimeline}, Path=CurrentTimeRange}" Value="{x:Static local:PlaybackTimelineRangeType.H1}">
                                                <Setter Property="Text" Value="1시간"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource  Mode=FindAncestor, AncestorType=local:OpnxPlaybackTimeline}, Path=CurrentTimeRange}" Value="{x:Static local:PlaybackTimelineRangeType.H3}">
                                                <Setter Property="Text" Value="3시간"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource  Mode=FindAncestor, AncestorType=local:OpnxPlaybackTimeline}, Path=CurrentTimeRange}" Value="{x:Static local:PlaybackTimelineRangeType.H6}">
                                                <Setter Property="Text" Value="6시간"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource  Mode=FindAncestor, AncestorType=local:OpnxPlaybackTimeline}, Path=CurrentTimeRange}" Value="{x:Static local:PlaybackTimelineRangeType.H12}">
                                                <Setter Property="Text" Value="12시간"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource  Mode=FindAncestor, AncestorType=local:OpnxPlaybackTimeline}, Path=CurrentTimeRange}" Value="{x:Static local:PlaybackTimelineRangeType.H24}">
                                                <Setter Property="Text" Value="24시간"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource  Mode=FindAncestor, AncestorType=local:OpnxPlaybackTimeline}, Path=CurrentTimeRange}" Value="{x:Static local:PlaybackTimelineRangeType.D3}">
                                                <Setter Property="Text" Value="3일"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                <Button Grid.Column="1" Grid.Row="0" x:Name="btnIncTimeRange" Width="30" Height="30" Cursor="Hand" Margin="0,0,0,1" Click="HandleIncreaseTimeRangeClick">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Black" BorderBrush="Transparent" BorderThickness="0" >
                                        <Image Width="15" Height="15" Source="/OnEyes.Client.Shared;component/Resources/Common/Plus_Normal.png" Stretch="Fill"  HorizontalAlignment="Center" VerticalAlignment="Center"></Image>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="Button.IsMouseOver" Value="true">
                                            <Setter Property="Opacity" TargetName="border" Value="0.8" />
                                        </Trigger>
                                        <Trigger Property="Button.IsPressed" Value="true">
                                            <Setter Property="Opacity" TargetName="border" Value="1.0" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                <Button Grid.Column="1" Grid.Row="1" x:Name="btnDecTimeRange" Width="30" Height="30" Cursor="Hand" Click="HandleDecreaseTimeRangeClick" Margin="0,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Black" BorderBrush="Transparent" BorderThickness="0" >
                                        <Image Width="15" Height="15" Source="/OnEyes.Client.Shared;component/Resources/Common/Minus_Normal.png" Stretch="Fill"  HorizontalAlignment="Center" VerticalAlignment="Center"></Image>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="Button.IsMouseOver" Value="true">
                                            <Setter Property="Opacity" TargetName="border" Value="0.8" />
                                        </Trigger>
                                        <Trigger Property="Button.IsPressed" Value="true">
                                            <Setter Property="Opacity" TargetName="border" Value="1.0" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    <ListBox Grid.Row="1" x:Name="xEntityListBox"  BorderBrush="Transparent"  BorderThickness="1" Margin="0,0,0,0"
                             Foreground="White" FontSize="12" FontFamily="NanumBarunGothic"
                             Style="{StaticResource ListBoxStyRecordData}"
                             ItemsSource="{Binding ElementName=xTimelineCanvas, Path=TimelineRecords}" >
                    </ListBox>
                    <Rectangle Fill="#FF444444" Height="1" Margin="0" VerticalAlignment="Bottom" StrokeThickness="0" SnapsToDevicePixels="True" Grid.Row="0"></Rectangle>
                    <!--<Rectangle Fill="#FF444444" Height="1" Margin="0" VerticalAlignment="Bottom" StrokeThickness="0" SnapsToDevicePixels="True" Grid.Row="1"></Rectangle>-->
                </Grid>
                <Grid x:Name="xTimeLineGrid" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid HorizontalAlignment="Left" Margin="5,0,0,0" Grid.Row="0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.5*"/>
                            <RowDefinition Height="0.5*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="xTextBlockVisibleStartDate" Margin="0" TextWrapping="Wrap" d:LayoutOverrides="Height" Foreground="#FFCCCCCC" HorizontalAlignment="Left" VerticalAlignment="Bottom" Text="2011년 11월 17일 목요일" FontSize="10.667"/>
                        <TextBlock x:Name="xTextBlockVisibleStartTime" TextWrapping="Wrap" Text="13:24:24.143" Margin="0" d:LayoutOverrides="Height" Grid.Row="1" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10.667"/>
                    </Grid>
                    <Grid HorizontalAlignment="Center" Margin="0" Grid.Row="0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.5*"/>
                            <RowDefinition Height="0.5*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="xTextBlockVisibleCenterDate" TextWrapping="Wrap" d:LayoutOverrides="Height" Foreground="#FFCCCCCC" HorizontalAlignment="Center" VerticalAlignment="Top" Text="2011년 11월 17일 목요일" FontSize="10.667"/>
                        <TextBlock x:Name="xTextBlockVisibleCenterTime" TextWrapping="Wrap" Text="13:24:24.143" Margin="0" d:LayoutOverrides="Height" Grid.Row="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10.667"/>
                    </Grid>
                    <Grid HorizontalAlignment="Right" Margin="0,0,5,0" Grid.Row="0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.5*"/>
                            <RowDefinition Height="0.5*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="xTextBlockVisibleEndDate" Margin="0" TextWrapping="Wrap" d:LayoutOverrides="Height" Foreground="#FFCCCCCC" HorizontalAlignment="Right" VerticalAlignment="Bottom" Text="2011년 11월 17일 목요일" FontSize="10.667"/>
                        <TextBlock x:Name="xTextBlockVisibleEndTime" TextWrapping="Wrap" Text="13:24:24.143" Margin="0" d:LayoutOverrides="Height" Grid.Row="1" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10.667"/>
                    </Grid>
                    <Canvas x:Name="xCanvasOuter" Grid.Row="1" Background="Transparent" ClipToBounds="True">
                        <Canvas x:Name="xCanvasTime" Height="20" Width="1613" Canvas.Left="0" Canvas.Top="0">
                            <TextBlock x:Name="xTextBlockTime01" TextWrapping="Wrap" Text="13  10" Width="50" Foreground="White" Canvas.Left="121.764" Canvas.Top="0" TextAlignment="Center"/>
                            <TextBlock x:Name="xTextBlockTime02" TextWrapping="Wrap" Text="13  20" Width="50" Foreground="White" Canvas.Left="387.165" Canvas.Top="0" TextAlignment="Center"/>
                            <TextBlock x:Name="xTextBlockTime03" TextWrapping="Wrap" Text="13  30" Width="50" Foreground="White" Canvas.Left="659.612" Canvas.Top="0" TextAlignment="Center"/>
                            <TextBlock x:Name="xTextBlockTime04" TextWrapping="Wrap" Text="13  40" VerticalAlignment="Bottom" Width="50" Foreground="White" Canvas.Left="938" Canvas.Top="0" TextAlignment="Center"/>
                            <TextBlock x:Name="xTextBlockTime05" TextWrapping="Wrap" Text="13  50" VerticalAlignment="Bottom" Width="50" Foreground="White" Canvas.Left="1196.863" Canvas.Top="0" TextAlignment="Center"/>
                            <TextBlock x:Name="xTextBlockTime06" TextWrapping="Wrap" Text="14  00" VerticalAlignment="Bottom" Width="50" Foreground="White" Canvas.Left="1454.984" Canvas.Top="0" TextAlignment="Center"/>
                        </Canvas>

                        <ScrollViewer x:Name="xScrollViewer" Width="1613" Height="215" Canvas.Left="0" Canvas.Top="20">
                            <Canvas x:Name="xCanvasInner" Background="Transparent" ClipToBounds="True">
                                <local:OpnxPlaybackTimelineCanvas x:Name="xTimelineCanvas" ParentTimelineControl="{Binding RelativeSource={RelativeSource AncestorType=local:OpnxPlaybackTimeline}}" />

                                <!--
    								<Rectangle x:Name="xRectangleCameraSelected" Fill="#FF73B2F2" Height="21" Canvas.Top="7" Width="1596"/>
    								<Rectangle x:Name="xRectangleCameraBackground01" Fill="#66000000" Height="15" Canvas.Top="10" Width="1596"/>
                                    <Rectangle x:Name="xRectangleCameraBackground02" Fill="#33000000" Height="15" Canvas.Top="40" Width="1596"/>
                                    <Rectangle x:Name="xRectangleCameraBackground03" Fill="#33000000" Height="15" Canvas.Top="70" Width="1596"/>
                                    <Rectangle x:Name="xRectangleCameraBackground04" Fill="#33000000" Height="15" Canvas.Top="100" Width="1596"/>
                                    <Rectangle x:Name="xRectangleCameraBackground05" Fill="#33000000" Height="15" Canvas.Top="130" Width="1596"/>
                                    <Rectangle x:Name="xRectangleCameraBackground05_Copy" Fill="#33000000" Height="15" Canvas.Top="160" Width="1596"/>
                                    <Rectangle x:Name="xRectangleCameraBackground05_Copy1" Fill="#33000000" Height="15" Canvas.Top="190" Width="1596"/>
                                    
