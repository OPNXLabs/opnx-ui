<UserControl x:Class="OPNX.UI.WPF.Controls.OpnxTimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OPNX.UI.WPF.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             d:DesignHeight="30"
             d:DesignWidth="120"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="DropDownButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background"
                    Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag.DropDownButtonBackground}" />
            <Setter Property="BorderBrush"
                    Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag.DropDownButtonBorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag.DropDownButtonBorderThickness}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag.DropDownButtonCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background"
                                        Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag.DropDownButtonCheckedBackground}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush"
                                        Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag.DropDownButtonCheckedBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background"
                                        Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag.DropDownButtonMouseOverBackground}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush"
                                        Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag.DropDownButtonMouseOverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background"
                                        Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag.DropDownButtonPressedBackground}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush"
                                        Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag.DropDownButtonPressedBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimeListItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background"
                    Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag.PopupItemBackground}" />
            <Setter Property="BorderBrush"
                    Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag.PopupItemBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground"
                    Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag.PopupForeground}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin"
                    Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag.PopupItemMargin}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Tag"
                    Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=Tag}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag.PopupItemCornerRadius}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag.PopupItemMouseOverBackground}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush"
                                        Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag.PopupItemMouseOverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground"
                                        Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag.PopupSelectedItemForeground}" />
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag.PopupSelectedItemBackground}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush"
                                        Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag.PopupSelectedItemBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Background="{Binding ElementName=Root, Path=Background}"
                BorderBrush="{Binding ElementName=Root, Path=BorderBrush}"
                BorderThickness="{Binding ElementName=Root, Path=BorderThickness}"
                CornerRadius="{Binding ElementName=Root, Path=CornerRadius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="6,0,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="HourSegment"
                             Grid.Column="0"
                             Background="Transparent"
                             BorderThickness="0"
                             CaretBrush="{Binding ElementName=Root, Path=Foreground}"
                             Foreground="{Binding ElementName=Root, Path=Foreground}"
                             HorizontalContentAlignment="Center"
                             MaxLength="2"
                             Padding="0"
                             VerticalContentAlignment="Center"
                             DataObject.Pasting="Segment_Pasting"
                             GotKeyboardFocus="Segment_GotKeyboardFocus"
                             LostKeyboardFocus="Segment_LostKeyboardFocus"
                             MouseWheel="Segment_MouseWheel"
                             PreviewKeyDown="Segment_PreviewKeyDown"
                             PreviewMouseDown="Segment_PreviewMouseDown"
                             PreviewTextInput="Segment_PreviewTextInput"
                             TextChanged="Segment_TextChanged" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="{Binding ElementName=Root, Path=Foreground}"
                               IsHitTestVisible="False"
                               Text=":" />
                    <TextBox x:Name="MinuteSegment"
                             Grid.Column="2"
                             Background="Transparent"
                             BorderThickness="0"
                             CaretBrush="{Binding ElementName=Root, Path=Foreground}"
                             Foreground="{Binding ElementName=Root, Path=Foreground}"
                             HorizontalContentAlignment="Center"
                             MaxLength="2"
                             Padding="0"
                             VerticalContentAlignment="Center"
                             DataObject.Pasting="Segment_Pasting"
                             GotKeyboardFocus="Segment_GotKeyboardFocus"
                             LostKeyboardFocus="Segment_LostKeyboardFocus"
                             MouseWheel="Segment_MouseWheel"
                             PreviewKeyDown="Segment_PreviewKeyDown"
                             PreviewMouseDown="Segment_PreviewMouseDown"
                             PreviewTextInput="Segment_PreviewTextInput"
                             TextChanged="Segment_TextChanged" />
                    <TextBlock Grid.Column="3"
                               VerticalAlignment="Center"
                               Foreground="{Binding ElementName=Root, Path=Foreground}"
                               IsHitTestVisible="False"
                               Text=":" />
                    <TextBox x:Name="SecondSegment"
                             Grid.Column="4"
                             Background="Transparent"
                             BorderThickness="0"
                             CaretBrush="{Binding ElementName=Root, Path=Foreground}"
                             Foreground="{Binding ElementName=Root, Path=Foreground}"
                             HorizontalContentAlignment="Center"
                             MaxLength="2"
                             Padding="0"
                             VerticalContentAlignment="Center"
                             DataObject.Pasting="Segment_Pasting"
                             GotKeyboardFocus="Segment_GotKeyboardFocus"
                             LostKeyboardFocus="Segment_LostKeyboardFocus"
                             MouseWheel="Segment_MouseWheel"
                             PreviewKeyDown="Segment_PreviewKeyDown"
                             PreviewMouseDown="Segment_PreviewMouseDown"
                             PreviewTextInput="Segment_PreviewTextInput"
                             TextChanged="Segment_TextChanged" />
                </Grid>

                <ToggleButton x:Name="PART_DropDownButton"
                              Grid.Column="1"
                              Width="{Binding ElementName=Root, Path=DropDownButtonWidth}"
                              Cursor="Hand"
                              Focusable="False"
                              IsChecked="{Binding ElementName=Root, Path=IsDropDownOpen, Mode=TwoWay}"
                              Style="{StaticResource DropDownButtonStyle}"
                              Tag="{Binding ElementName=Root}"
                              Visibility="{Binding ElementName=Root, Path=DropDownButtonVisibility}">
                    <Path Width="8"
                          Height="5"
                          Data="M 0,0 L 4,4 L 8,0"
                          Stretch="Fill"
                          Stroke="{Binding ElementName=Root, Path=IconBrush}"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeThickness="1.2" />
                </ToggleButton>
            </Grid>
        </Border>

        <Popup x:Name="PART_Popup"
               AllowsTransparency="True"
               IsOpen="{Binding ElementName=Root, Path=IsDropDownOpen, Mode=TwoWay}"
               Opened="Popup_Opened"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=Root}"
               StaysOpen="{Binding ElementName=Root, Path=StaysOpen}">
            <Border Margin="0,2,0,0"
                    Padding="4"
                    Background="{Binding ElementName=Root, Path=PopupBackground}"
                    BorderBrush="{Binding ElementName=Root, Path=PopupBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{Binding ElementName=Root, Path=PopupCornerRadius}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{Binding ElementName=Root, Path=PopupForeground}"
                               Text="{Binding ElementName=Root, Path=HourHeader}" />
                    <TextBlock Grid.Row="0" Grid.Column="2"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{Binding ElementName=Root, Path=PopupForeground}"
                               Text="{Binding ElementName=Root, Path=MinuteHeader}" />
                    <TextBlock Grid.Row="0" Grid.Column="4"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{Binding ElementName=Root, Path=PopupForeground}"
                               Text="{Binding ElementName=Root, Path=SecondHeader}" />

                    <ListBox x:Name="HourList"
                             Grid.Row="1"
                             Grid.Column="0"
                             Height="120"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{Binding ElementName=Root, Path=PopupForeground}"
                             ItemContainerStyle="{StaticResource TimeListItemStyle}"
                             ItemsSource="{Binding ElementName=Root, Path=Hours}"
                             Tag="{Binding ElementName=Root}"
                             SelectionChanged="TimeList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="30" Height="24">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Text="{Binding StringFormat={}{0:00}}"
                                               TextAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.RowSpan="2" Grid.Column="1" Background="{Binding ElementName=Root, Path=PopupBorderBrush}" />
                    <ListBox x:Name="MinuteList"
                             Grid.Row="1"
                             Grid.Column="2"
                             Height="120"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{Binding ElementName=Root, Path=PopupForeground}"
                             ItemContainerStyle="{StaticResource TimeListItemStyle}"
                             ItemsSource="{Binding ElementName=Root, Path=Minutes}"
                             Tag="{Binding ElementName=Root}"
                             SelectionChanged="TimeList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="30" Height="24">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Text="{Binding StringFormat={}{0:00}}"
                                               TextAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.RowSpan="2" Grid.Column="3" Background="{Binding ElementName=Root, Path=PopupBorderBrush}" />
                    <ListBox x:Name="SecondList"
                             Grid.Row="1"
                             Grid.Column="4"
                             Height="120"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{Binding ElementName=Root, Path=PopupForeground}"
                             ItemContainerStyle="{StaticResource TimeListItemStyle}"
                             ItemsSource="{Binding ElementName=Root, Path=Seconds}"
                             Tag="{Binding ElementName=Root}"
                             SelectionChanged="TimeList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="30" Height="24">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Text="{Binding StringFormat={}{0:00}}"
                                               TextAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
