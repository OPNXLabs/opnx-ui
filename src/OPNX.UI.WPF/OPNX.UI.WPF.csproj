<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release</Configurations>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Product>OPNX.UI.WPF</Product>
    <Description>OPNX WPF UI library for VMS, NVR, and real-time monitoring applications. Preview package for non-commercial evaluation; commercial or production use requires a written OPNX license.</Description>
    <OpnxLibVersion Condition="'$(OpnxLibVersion)' == ''">0.1.0-preview.20260716.1</OpnxLibVersion>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.Direct3D9" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(SolutionName)' == 'OPNX.UI.Dev'">

    <ProjectReference Include="..\..\..\opnx-lib\src\OPNX.Lib.Common\OPNX.Lib.Common.csproj" />
    <ProjectReference Include="..\..\..\opnx-lib\src\OPNX.Lib.Data\OPNX.Lib.Data.csproj" />
    <ProjectReference Include="..\..\..\opnx-lib\src\OPNX.Lib.Media\OPNX.Lib.Media.csproj" />
    <ProjectReference Include="..\..\..\opnx-lib\src\OPNX.Lib.Network\OPNX.Lib.Network.csproj" />
    <ProjectReference Include="..\..\..\opnx-lib\src\OPNX.Lib.Streaming\OPNX.Lib.Streaming.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(SolutionName)' != 'OPNX.UI.Dev'">
    <PackageReference Include="OPNX.Lib" Version="$(OpnxLibVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\LICENSE.ko.txt" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\README.ko.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\third_party_licenses\MIT.txt" Pack="true" PackagePath="third_party_licenses/" Visible="false" />
  </ItemGroup>
</Project>
